# =============================================================================
# Quantum Ledger — variables de entorno
# Copia este archivo como `.env` solo para desarrollo local. En Render/Neon,
# configura estas variables en la consola del servicio (ver render.yaml).
# =============================================================================

# --- Servidor de producción (server/index.js — servicio web de Render) ---
# Cadena de conexión PostgreSQL (Neon Free). Obligatoria en producción.
# Ejemplo: postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# Secreto usado para firmar los tokens de sesión. Al menos 32 caracteres.
# render.yaml lo genera automáticamente (generateValue: true).
APP_TOKEN_SECRET=

# Cuenta de administrador que se crea en el primer arranque (si no existe).
ADMIN_EMAIL=admin@quantumledgerbusiness.com
# Mínimo 12 caracteres. render.yaml lo genera automáticamente.
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# --- SMTP (opcional en el plan gratuito) ---
# Sin SMTP la app funciona, pero no se envían correos de bienvenida, documentos
# ni códigos de recuperación de contraseña.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Frontend (cliente Vite, solo si el API vive en otro origen) ---
# Si el frontend y el API se sirven desde el mismo origen (como en el servicio
# web de Render), no hace falta definirla. En desarrollo Vite la omite y usa el
# proxy /api -> http://localhost:10000.
VITE_API_BASE_URL=

# --- Modo local (npm run dev:local -> server/local.js) ---
# Opcionales; hay valores por defecto seguros para desarrollo.
LOCAL_API_PORT=10000
LOCAL_ADMIN_EMAIL=admin@quantumledger.local
LOCAL_ADMIN_PASSWORD=Admin123!